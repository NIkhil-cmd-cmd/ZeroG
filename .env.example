# ZeroG Environment Variables
# Copy to .env in project root and web/.env.local for Next.js

# Required for real agent runs and embeddings
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-openai-key

# Optional fallback
ANTHROPIC_API_KEY=your-anthropic-key-as-fallback

# Python engine
ZEROG_DB_PATH=zerog.db

# Public URLs (production)
ZEROG_PUBLIC_URL=https://zerog-production.up.railway.app
ZEROG_WEB_URL=https://web-pi-nine-22.vercel.app

# Next.js — local dev overrides public engine
# ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_ENGINE_URL=https://zerog-production.up.railway.app
