# ZeroG Environment Variables
# Copy to .env in project root and web/.env.local for Next.js

# Required for real agent runs and embeddings
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key

# Optional fallback
ANTHROPIC_API_KEY=your-anthropic-key-as-fallback

# Python engine (local default)
ZEROG_DB_PATH=./engine/zerog.db

# Next.js — point to Python engine (optional, falls back to simulated demo)
ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000
